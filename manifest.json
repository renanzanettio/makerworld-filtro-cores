{
  "manifest_version": 3,
  "name": "MakerWorld — Minhas cores",
  "version": "0.1.0",
  "description": "Filtra os modelos carregados no MakerWorld pelas cores dos perfis de impressão e pelos filamentos que você tem.",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "host_permissions": ["https://makerworld.com/*", "https://api.bambulab.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://makerworld.com/*"],
    "js": ["core.js", "content.js"],
    "css": ["cards.css"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "MakerWorld — Minhas cores",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
